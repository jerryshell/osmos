{
  "name": "osmos-web",
  "version": "0.0.0",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "serve": "vite preview",
    "build:wasm": "cd ../osmos-wasm && wasm-pack build --release --out-dir ../osmos-web/osmos-wasm",
    "build:all": "npm run build:wasm && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.12",
    "vite-plugin-wasm": "^3.6.0"
  },
  "dependencies": {
    "solid-js": "^1.9.5"
  }
}
